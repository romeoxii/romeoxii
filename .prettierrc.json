{
	"semi": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"tabWidth": 4,
	"useTabs": true,
	"endOfLine": "lf",
	"arrowParens": "always",
	"bracketSpacing": true,
	"vueIndentScriptAndStyle": false,
	"singleAttributePerLine": false,
	"htmlWhitespaceSensitivity": "ignore"
}
